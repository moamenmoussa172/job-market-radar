# Copy this file to .env and change the passwords.
# (PowerShell: Copy-Item .env.example .env)

AIRFLOW_VERSION=3.3.2
AIRFLOW_UID=50000

# Airflow web login (http://localhost:8080)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me_airflow

# Shared secret for Airflow 3 components - any long random string
AIRFLOW_JWT_SECRET=change_me_to_a_long_random_string
# Optional: encrypts connection passwords stored in Airflow's DB
FERNET_KEY=

# Postgres superuser + Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_pg

# Warehouse DB (raw + staging + marts) - created on first start
WAREHOUSE_DB_USER=jobradar
WAREHOUSE_DB_PASSWORD=change_me_wh

# Metabase application DB - created on first start
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=change_me_mb

# Object storage (SeaweedFS S3). Must match infra/seaweedfs/s3.json
S3_ACCESS_KEY=jobradar_access_key
S3_SECRET_KEY=jobradar_secret_key_change_me
S3_RAW_BUCKET=jobradar-raw
